---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
---

<Layout
  title={`Contact Us | ${site.name}`}
  description="Contact LandSlide Trading and Contracting Company in Doha, Qatar. Get in touch for construction consultancy, contracting inquiries, and partnership opportunities."
>
  <section class="page-hero">
    <div class="container">
      <span class="hero-tag">Reach Out</span>
      <h1 class="page-hero-title">Contact Information</h1>
      <p class="page-hero-desc">
        We look forward to discussing your upcoming project, joint venture, or engineering consultancy requirements.
      </p>
    </div>
  </section>

  <section class="py-section bg-white">
    <div class="container">
      <div class="contact-grid">
        <!-- Contact Information Cards -->
        <div class="contact-info-column">
          <span class="section-tag">Head Office</span>
          <h2 class="contact-section-title">Get In Touch</h2>
          <p class="contact-lead-text">
            Our multidisciplinary team of senior consultants and construction managers is available to assist you with commercial contracting and technical inquiries.
          </p>

          <div class="contact-cards-stack">
            <div class="info-card">
              <div class="icon-circle">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              </div>
              <div>
                <h4>Call Our Office</h4>
                <p>Direct telephone line</p>
                <a href={`tel:${site.contact.phone}`} class="contact-link">{site.contact.phone}</a>
              </div>
            </div>

            <div class="info-card">
              <div class="icon-circle">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              </div>
              <div>
                <h4>Email Inquiries</h4>
                <p>General & commercial requests</p>
                <a href={`mailto:${site.contact.email}`} class="contact-link">{site.contact.email}</a>
              </div>
            </div>

            <div class="info-card">
              <div class="icon-circle">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              </div>
              <div>
                <h4>Location</h4>
                <p>Corporate headquarters</p>
                <span class="contact-text-bold">{site.contact.address}</span>
              </div>
            </div>

            <div class="info-card">
              <div class="icon-circle">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              </div>
              <div>
                <h4>Working Hours</h4>
                <p>Operational schedule</p>
                <span class="contact-text-bold">{site.contact.hours}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Contact Form Box -->
        <div class="contact-form-column">
          <div class="form-panel">
            <h3 class="form-title">Send a Message</h3>
            <p class="form-subtitle">Fill in the form below and an engineering consultant will contact you promptly.</p>

            <form id="contact-form" class="main-contact-form" method="POST">
              <div class="form-group">
                <label class="form-label" for="contact-name">Full Name <span class="req">*</span></label>
                <input type="text" id="contact-name" name="name" required class="form-input" placeholder="Your Name" />
              </div>

              <div class="form-group">
                <label class="form-label" for="contact-email">Email Address <span class="req">*</span></label>
                <input type="email" id="contact-email" name="email" required class="form-input" placeholder="name@company.com" />
              </div>

              <div class="form-group">
                <label class="form-label" for="contact-phone">Phone Number</label>
                <input type="tel" id="contact-phone" name="phone" class="form-input" placeholder="+974 XXXX XXXX" />
              </div>

              <div class="form-group">
                <label class="form-label" for="contact-message">Your Message <span class="req">*</span></label>
                <textarea id="contact-message" name="message" required rows="5" class="form-textarea" placeholder="How can LandSlide support your project?"></textarea>
              </div>

              <button type="submit" class="btn btn-primary btn-submit">
                Send Message
              </button>
              <div id="contact-status" class="status-msg"></div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #07192e 0%, #0d2847 60%, #164273 100%);
    color: #ffffff;
    padding: 5rem 0;
    text-align: center;
  }

  .hero-tag {
    display: inline-block;
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: rgba(217, 147, 27, 0.15);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 1rem;
  }

  .page-hero-title {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .page-hero-title {
      font-size: 3.25rem;
    }
  }

  .page-hero-desc {
    font-size: 1.15rem;
    color: #cbd5e1;
    max-width: 720px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr 1.2fr;
      align-items: start;
    }
  }

  .contact-section-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--primary);
    margin-bottom: 1rem;
  }

  .contact-lead-text {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.65;
    margin-bottom: 2rem;
  }

  .contact-cards-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .info-card {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    background: #f8fafc;
    border: 1px solid var(--border-color);
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-md);
    transition: var(--transition);
  }

  .info-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .icon-circle {
    width: 44px;
    height: 44px;
    background: var(--accent-light);
    color: var(--accent);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .info-card h4 {
    font-size: 1rem;
    color: var(--primary);
    margin-bottom: 0.15rem;
  }

  .info-card p {
    font-size: 0.8rem;
    color: var(--text-light);
    margin-bottom: 0.25rem;
  }

  .contact-link {
    font-size: 1rem;
    font-weight: 700;
    color: var(--primary);
  }

  .contact-link:hover {
    color: var(--accent);
  }

  .contact-text-bold {
    font-size: 1rem;
    font-weight: 700;
    color: var(--primary);
  }

  /* Form */
  .form-panel {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 2.5rem;
  }

  @media (max-width: 640px) {
    .form-panel {
      padding: 1.5rem;
    }
  }

  .form-title {
    font-size: 1.65rem;
    font-weight: 800;
    color: var(--primary);
    margin-bottom: 0.4rem;
  }

  .form-subtitle {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 2rem;
  }

  .btn-submit {
    width: 100%;
    padding: 1rem;
    font-size: 1.05rem;
    margin-top: 0.5rem;
  }

  .status-msg {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    display: none;
    font-size: 0.9rem;
    text-align: center;
  }

  .status-msg.success {
    display: block;
    background: #dcfce7;
    color: #15803d;
    border: 1px solid #bbf7d0;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('contact-status');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (status) {
      status.className = 'status-msg success';
      status.textContent = 'Thank you! Your message has been sent successfully. A member of our consultancy team will get back to you shortly.';
      form.reset();
    }
  });
</script>
