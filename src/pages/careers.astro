---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
---

<Layout
  title={`Careers | ${site.name}`}
  description="Join our team of engineering and contracting professionals shaping Qatar's architectural landscape."
>
  <section class="page-hero">
    <div class="container">
      <span class="hero-tag">Join Our Team</span>
      <h1 class="page-hero-title">Careers at LandSlide</h1>
      <p class="page-hero-desc">
        Explore rewarding engineering, project management, and construction opportunities on Qatar’s most iconic developments.
      </p>
    </div>
  </section>

  <section class="py-section bg-white">
    <div class="container container-narrow">
      <div class="career-intro">
        <h2>Submit Your Resume Below</h2>
        <p>
          At LandSlide Trading and Contracting, we believe our people are our greatest strength. We offer an inclusive, safety-first workplace where engineering talent thrives and makes a visible impact on Qatar’s skyline.
        </p>
      </div>

      <div class="perks-row">
        <div class="perk-box">
          <span class="perk-icon">👷‍♂️</span>
          <h4>Iconic Projects</h4>
          <p>Work on premier civil, marine, and commercial infrastructure.</p>
        </div>
        <div class="perk-box">
          <span class="perk-icon">📈</span>
          <h4>Career Growth</h4>
          <p>Continuous professional development and leadership tracks.</p>
        </div>
        <div class="perk-box">
          <span class="perk-icon">🛡️</span>
          <h4>Safety Culture</h4>
          <p>Zero-harm standard with highest health and safety protocols.</p>
        </div>
      </div>

      <div class="form-wrapper">
        <form id="careers-form" class="careers-form" method="POST">
          <h3 class="form-title">Application Form</h3>

          <div class="grid-2-form">
            <div class="form-group">
              <label class="form-label" for="first-name">First Name <span class="req">*</span></label>
              <input type="text" id="first-name" name="firstName" required class="form-input" placeholder="e.g. John" />
            </div>
            <div class="form-group">
              <label class="form-label" for="last-name">Last Name <span class="req">*</span></label>
              <input type="text" id="last-name" name="lastName" required class="form-input" placeholder="e.g. Doe" />
            </div>
          </div>

          <div class="grid-2-form">
            <div class="form-group">
              <label class="form-label" for="email">Email Address <span class="req">*</span></label>
              <input type="email" id="email" name="email" required class="form-input" placeholder="john.doe@example.com" />
            </div>
            <div class="form-group">
              <label class="form-label" for="phone">Mobile Phone <span class="req">*</span></label>
              <input type="tel" id="phone" name="phone" required class="form-input" placeholder="+974 XXXX XXXX" />
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="address">Street Address <span class="req">*</span></label>
            <input type="text" id="address" name="address" required class="form-input" placeholder="Street Address" />
          </div>

          <div class="grid-3-form">
            <div class="form-group">
              <label class="form-label" for="city">City <span class="req">*</span></label>
              <input type="text" id="city" name="city" required class="form-input" placeholder="Doha" />
            </div>
            <div class="form-group">
              <label class="form-label" for="state">State / Province</label>
              <input type="text" id="state" name="state" class="form-input" placeholder="State/Province" />
            </div>
            <div class="form-group">
              <label class="form-label" for="zip">Zip / Postal Code</label>
              <input type="text" id="zip" name="zip" class="form-input" placeholder="Postal Code" />
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Employment Desired <span class="req">*</span></label>
            <div class="radio-group">
              <label class="radio-label">
                <input type="radio" name="employmentType" value="Full-time" checked />
                <span>Full-time</span>
              </label>
              <label class="radio-label">
                <input type="radio" name="employmentType" value="Part-time" />
                <span>Part-time</span>
              </label>
              <label class="radio-label">
                <input type="radio" name="employmentType" value="Full- or Part-time" />
                <span>Full- or Part-time</span>
              </label>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="resume">Attach Resume / CV</label>
            <div class="file-upload-box">
              <input type="file" id="resume" name="resume" accept=".pdf,.doc,.docx" class="file-input" />
              <div class="file-dummy">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                <span>Click or drag your CV (PDF, DOCX up to 10MB)</span>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="notes">Additional Information / Cover Note</label>
            <textarea id="notes" name="notes" rows="4" class="form-textarea" placeholder="Tell us about your key skills and certifications..."></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-submit">
            Submit Application
          </button>
          <div id="career-status" class="status-msg"></div>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #07192e 0%, #0d2847 60%, #164273 100%);
    color: #ffffff;
    padding: 5rem 0;
    text-align: center;
  }

  .hero-tag {
    display: inline-block;
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: rgba(217, 147, 27, 0.15);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 1rem;
  }

  .page-hero-title {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .page-hero-title {
      font-size: 3.25rem;
    }
  }

  .page-hero-desc {
    font-size: 1.15rem;
    color: #cbd5e1;
    max-width: 720px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .career-intro {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .career-intro h2 {
    font-size: 2rem;
    font-weight: 800;
    color: var(--primary);
    margin-bottom: 0.75rem;
  }

  .career-intro p {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .perks-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }

  @media (min-width: 640px) {
    .perks-row {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .perk-box {
    background: #f8fafc;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    text-align: center;
  }

  .perk-icon {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    display: block;
  }

  .perk-box h4 {
    font-size: 1.1rem;
    color: var(--primary);
    margin-bottom: 0.35rem;
  }

  .perk-box p {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .form-wrapper {
    background: #ffffff;
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-lg);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
  }

  @media (max-width: 640px) {
    .form-wrapper {
      padding: 1.5rem;
    }
  }

  .form-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--primary);
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-light);
  }

  .grid-2-form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .grid-2-form {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .grid-3-form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .grid-3-form {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .radio-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 0.5rem 0;
  }

  .radio-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    cursor: pointer;
  }

  .file-upload-box {
    position: relative;
    border: 2px dashed var(--border-color);
    border-radius: var(--radius-sm);
    padding: 1.75rem 1rem;
    text-align: center;
    background: #f8fafc;
    transition: var(--transition);
  }

  .file-upload-box:hover {
    border-color: var(--accent);
    background: var(--accent-light);
  }

  .file-input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
    width: 100%;
    height: 100%;
  }

  .file-dummy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .file-dummy svg {
    color: var(--accent);
  }

  .btn-submit {
    width: 100%;
    margin-top: 1rem;
    padding: 1rem;
    font-size: 1.05rem;
  }

  .status-msg {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    display: none;
    font-size: 0.9rem;
    text-align: center;
  }

  .status-msg.success {
    display: block;
    background: #dcfce7;
    color: #15803d;
    border: 1px solid #bbf7d0;
  }
</style>

<script>
  const form = document.getElementById('careers-form') as HTMLFormElement;
  const status = document.getElementById('career-status');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (status) {
      status.className = 'status-msg success';
      status.textContent = 'Thank you! Your resume and application have been submitted successfully. Our talent team will review your profile.';
      form.reset();
    }
  });
</script>
