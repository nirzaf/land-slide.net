---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../data/projects.json';
import site from '../data/site.json';

const featuredProjects = projects.slice(0, 6);

const industries = [
  {
    name: 'Construction',
    desc: 'High-rise towers, commercial hubs, residential complexes, and civil infrastructure.',
    image: '/wp-content/uploads/2024/08/construction-2-768x512.jpg',
  },
  {
    name: 'Manufacturing',
    desc: 'Industrial processing facilities, warehousing, and manufacturing plant logistics.',
    image: '/wp-content/uploads/2024/08/manufacturing-1-768x512.jpg',
  },
  {
    name: 'Marine',
    desc: 'Coastal resorts, waterfront developments, ports, and marine engineering structures.',
    image: '/wp-content/uploads/2024/08/Marine-4-768x512.jpg',
  },
  {
    name: 'Oil & Gas',
    desc: 'Petroleum district complexes, specialized energy facilities, and industrial installations.',
    image: '/wp-content/uploads/2024/08/oil-and-gas-3-768x512.jpg',
  },
];

const pillars = [
  {
    title: 'Expert Guidance & Decision-Making',
    desc: 'Specialized technical knowledge to navigate complex engineering, architecture, design, and regulatory requirements with confidence.'
  },
  {
    title: 'Efficient Planning & Resource Management',
    desc: 'Precise scope definition, milestone scheduling, and dynamic allocation to prevent delays and optimize operational productivity.'
  },
  {
    title: 'Proactive Risk Mitigation',
    desc: 'Comprehensive threat assessments identifying vulnerabilities early in the project lifecycle to prevent costly schedule disruptions.'
  },
  {
    title: 'Impartial Conflict Resolution',
    desc: 'Expert third-party mediation between contractors, engineers, architects, and owners, protecting momentum and partnerships.'
  },
  {
    title: 'Compliance & Regulatory Adherence',
    desc: 'Rigorous alignment with Qatari and international building standards, permitting processes, and statutory safety mandates.'
  },
  {
    title: 'Cost Control & Budget Management',
    desc: 'Value engineering, accurate quantity surveying, and procurement discipline ensuring maximum return on capital investment.'
  },
  {
    title: 'Uncompromising Quality Assurance',
    desc: 'Stringent multi-tier inspection protocols guaranteeing superior craftsmanship, durable materials, and defect-free handover.'
  },
  {
    title: 'Sustainability & Technological Innovation',
    desc: 'Implementation of Building Information Modeling (BIM), eco-friendly materials, and energy-efficient green building methodologies.'
  }
];
---

<Layout
  title={`${site.name} | ${site.tagline}`}
  description="Pioneering Construction Excellence: LandSlide provides expert consultancy to construction companies across Qatar and internationally."
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-overlay"></div>
    <div class="container hero-container">
      <div class="hero-content">
        <span class="hero-badge">Pioneering Construction Excellence</span>
        <h1 class="hero-title">
          Building Excellence,<br />
          <span>Shaping Futures.</span>
        </h1>
        <p class="hero-subtitle">
          From Civil Works to Marine Projects, LandSlide provides expert consultancy to construction companies, ensuring your vision is built with precision, safety, and innovation.
        </p>
        <div class="hero-cta-group">
          <a href="/projects" class="btn btn-primary">
            Explore Our Projects
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
          <a href="/contact" class="btn btn-outline-white">
            Schedule a Consultation
          </a>
        </div>
      </div>
      <div class="hero-stats-card">
        <div class="stat-item">
          <span class="stat-number">2018</span>
          <span class="stat-label">Trusted Partner In Qatar</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">9+</span>
          <span class="stat-label">Iconic Megaprojects</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">100%</span>
          <span class="stat-label">Client-Centric Safety</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">4</span>
          <span class="stat-label">Core Industry Sectors</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Shaping a Sustainable Future -->
  <section class="py-section bg-white">
    <div class="container">
      <div class="grid-2">
        <div class="about-lead-content">
          <span class="section-tag">About LandSlide</span>
          <h2 class="section-title">Shaping a Sustainable Future</h2>
          <p class="text-body-lg">
            Land Slide Construction has left a lasting impression both nationally and internationally. With our extensive knowledge across diverse sectors, we lead the way in innovation to create a more sustainable and interconnected world.
          </p>
          <p class="text-body">
            By combining global perspectives with local expertise in Qatar, we develop forward-thinking solutions to address the challenges of tomorrow. Partner with us as we strive to build a better future through unwavering dedication to excellence in construction, contracting, and engineering consultancy.
          </p>
          <div class="about-highlights">
            <div class="highlight-item">
              <div class="highlight-icon">✓</div>
              <div>
                <strong>Market Expertise</strong>
                <p>Anticipating industry transformations and regulatory standards.</p>
              </div>
            </div>
            <div class="highlight-item">
              <div class="highlight-icon">✓</div>
              <div>
                <strong>Professional Team</strong>
                <p>Experienced engineers, planners, and project managers committed to delivery.</p>
              </div>
            </div>
            <div class="highlight-item">
              <div class="highlight-icon">✓</div>
              <div>
                <strong>Strategic Guidance</strong>
                <p>Supporting corporate and joint venture success through trusted advisory.</p>
              </div>
            </div>
          </div>
          <div style="margin-top: 2rem;">
            <a href="/about" class="btn btn-secondary">Read Full Story</a>
          </div>
        </div>
        <div class="about-lead-visual">
          <div class="image-stack">
            <img
              src="/wp-content/uploads/2024/08/CONSTRUCTION-CONSULTANCY-.jpg"
              alt="Construction Consultancy Qatar"
              class="img-main"
            />
            <div class="floating-badge">
              <span class="badge-number">6+</span>
              <span class="badge-text">Years of Proven Industry Track Record</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Service Section -->
  <section class="py-section bg-light">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-tag">Consultancy Services</span>
        <h2 class="section-title">Comprehensive Construction Advisory</h2>
        <p class="section-subtitle mx-auto">
          We ensure the successful planning, commercial protection, and seamless execution of high-stakes construction developments across Qatar.
        </p>
      </div>

      <div class="services-banner">
        <div class="services-banner-text">
          <h3>Empowering Contractors & Developers with Strategic Precision</h3>
          <p>
            LandSlide provides end-to-end construction consultancy services. Our expertise supports developers and contractors in critical areas including engineering review, contracting strategy, supply chain optimization, and dispute resolution.
          </p>
          <p>
            By leveraging our deep regional knowledge, clients save significant time and capital, prevent costly project delays, and maintain rigorous budget control. With LandSlide’s stewardship, construction projects are executed seamlessly.
          </p>
        </div>
        <div class="services-banner-img">
          <img
            src="/wp-content/uploads/2024/08/19550-blueprints-safety-helmet-computer-construction-site-sstock_233305984-768x427.jpg"
            alt="LandSlide Engineering Consultancy"
          />
        </div>
      </div>

      <!-- Industry Sectors Supported -->
      <div class="industries-header">
        <h3 class="subsection-title">Industries We Support</h3>
        <p class="text-muted">Specialized domain consultancy tailored to the distinct operational demands of each industry.</p>
      </div>

      <div class="grid-4-industries">
        {industries.map((ind) => (
          <div class="industry-card">
            <div class="industry-image-wrap">
              <img src={ind.image} alt={ind.name} loading="lazy" />
              <div class="industry-overlay"></div>
              <h4 class="industry-name">{ind.name}</h4>
            </div>
            <div class="industry-body">
              <p>{ind.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Projects Showcase -->
  <section class="py-section bg-white" id="projects">
    <div class="container">
      <div class="section-header-flex">
        <div>
          <span class="section-tag">Portfolio of Distinction</span>
          <h2 class="section-title">Participated Projects</h2>
          <p class="section-subtitle">
            A selection of landmark developments in Qatar where LandSlide has contributed technical expertise and contracting consultancy.
          </p>
        </div>
        <div>
          <a href="/projects" class="btn btn-outline">
            View All 9 Projects
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
      </div>

      <div class="grid-3">
        {featuredProjects.map((p) => (
          <ProjectCard
            title={p.title}
            slug={p.slug}
            category={p.category}
            summary={p.summary}
            image={p.image}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose LandSlide Section -->
  <section class="py-section bg-dark text-white">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-tag" style="background: rgba(217, 147, 27, 0.2); color: #f3b23e;">Why LandSlide</span>
        <h2 class="section-title text-white">Why LandSlide Trading & Contracting?</h2>
        <p class="section-subtitle mx-auto" style="color: #94a3b8;">
          Your reliable partner for expert guidance and innovative solutions in Qatar since 2018.
        </p>
      </div>

      <div class="pillars-grid">
        {pillars.map((pillar, index) => (
          <div class="pillar-card">
            <div class="pillar-number">0{index + 1}</div>
            <h4 class="pillar-title">{pillar.title}</h4>
            <p class="pillar-desc">{pillar.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero-section {
    position: relative;
    background: linear-gradient(135deg, #07192e 0%, #0d2847 60%, #164273 100%);
    color: #ffffff;
    padding: 6rem 0 7rem;
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(217, 147, 27, 0.12) 1px, transparent 1px);
    background-size: 30px 30px;
    opacity: 0.6;
    pointer-events: none;
  }

  .hero-container {
    position: relative;
    z-index: 2;
  }

  .hero-content {
    max-width: 820px;
    margin-bottom: 3.5rem;
  }

  .hero-badge {
    display: inline-block;
    background: rgba(217, 147, 27, 0.2);
    border: 1px solid rgba(217, 147, 27, 0.4);
    color: #f3b23e;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }

  .hero-title span {
    color: var(--accent);
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 4rem;
    }
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: #cbd5e1;
    line-height: 1.65;
    margin-bottom: 2.5rem;
    max-width: 720px;
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero-stats-card {
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    padding: 1.75rem 2rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .hero-stats-card {
      grid-template-columns: repeat(4, 1fr);
      align-items: center;
    }

    .stat-divider {
      display: none;
    }
  }

  .stat-item {
    display: flex;
    flex-direction: column;
  }

  .stat-number {
    font-size: 2.25rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1;
    margin-bottom: 0.35rem;
  }

  .stat-label {
    font-size: 0.85rem;
    color: #94a3b8;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  /* About Lead */
  .bg-white {
    background: #ffffff;
  }

  .bg-light {
    background: #f8fafc;
  }

  .bg-dark {
    background: #07192e;
  }

  .text-white {
    color: #ffffff !important;
  }

  .text-center {
    text-align: center;
  }

  .mx-auto {
    margin-left: auto;
    margin-right: auto;
  }

  .text-body-lg {
    font-size: 1.15rem;
    color: var(--primary);
    font-weight: 500;
    line-height: 1.65;
    margin-bottom: 1rem;
  }

  .text-body {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .about-highlights {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 1.5rem 0;
  }

  .highlight-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .highlight-icon {
    width: 24px;
    height: 24px;
    background: var(--accent);
    color: #ffffff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: bold;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .highlight-item strong {
    display: block;
    color: var(--primary);
    font-size: 0.95rem;
  }

  .highlight-item p {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin: 0;
  }

  .image-stack {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
  }

  .img-main {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4/3;
  }

  .floating-badge {
    position: absolute;
    bottom: 1.5rem;
    right: 1.5rem;
    background: var(--primary-dark);
    color: #ffffff;
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    border-left: 4px solid var(--accent);
    max-width: 220px;
  }

  .badge-number {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    color: var(--accent);
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .badge-text {
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.3;
    color: #e2e8f0;
  }

  /* Services Banner */
  .section-header {
    margin-bottom: 3rem;
  }

  .services-banner {
    background: #ffffff;
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border-color);
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 900px) {
    .services-banner {
      grid-template-columns: 1.2fr 1fr;
      align-items: center;
      padding: 3rem;
    }
  }

  .services-banner-text h3 {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--primary);
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .services-banner-text p {
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 1rem;
  }

  .services-banner-img {
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .services-banner-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Industries */
  .industries-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .subsection-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 0.5rem;
  }

  .grid-4-industries {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .grid-4-industries {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .grid-4-industries {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .industry-card {
    background: #ffffff;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border-color);
    transition: var(--transition);
  }

  .industry-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .industry-image-wrap {
    position: relative;
    height: 160px;
    overflow: hidden;
  }

  .industry-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .industry-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(7, 25, 46, 0.85) 0%, rgba(7, 25, 46, 0.2) 100%);
  }

  .industry-name {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    color: #ffffff;
    font-size: 1.2rem;
    font-weight: 700;
  }

  .industry-body {
    padding: 1.25rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Section Header Flex */
  .section-header-flex {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 768px) {
    .section-header-flex {
      flex-direction: row;
      align-items: flex-end;
    }
  }

  /* Pillars */
  .pillars-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .pillars-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .pillars-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .pillar-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    transition: var(--transition);
  }

  .pillar-card:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(217, 147, 27, 0.5);
    transform: translateY(-4px);
  }

  .pillar-number {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .pillar-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.5rem;
    line-height: 1.35;
  }

  .pillar-desc {
    font-size: 0.875rem;
    color: #94a3b8;
    line-height: 1.55;
  }
</style>
