---
import Layout from '../../layouts/Layout.astro';
import projects from '../../data/projects.json';
import site from '../../data/site.json';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

// Related projects (same category or next 2)
const relatedProjects = projects
  .filter((p) => p.slug !== project.slug)
  .slice(0, 3);
---

<Layout
  title={`${project.title} | Projects | ${site.name}`}
  description={project.summary}
  image={project.image}
>
  <!-- Project Hero Header -->
  <section class="project-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/projects">Projects</a>
        <span>/</span>
        <span class="current">{project.title}</span>
      </nav>
      <span class="project-tag">{project.category}</span>
      <h1 class="project-title">{project.title}</h1>
      <p class="project-lead">{project.summary}</p>
    </div>
  </section>

  <!-- Project Main Content -->
  <section class="py-section bg-white">
    <div class="container">
      <div class="project-layout">
        <!-- Main Column -->
        <article class="project-article">
          <div class="project-featured-image-box">
            <img src={project.image} alt={project.title} class="project-featured-image" />
          </div>

          <div class="project-content-body" set:html={project.content} />

          <div class="project-share-bar">
            <h4>Interested in our role on this development?</h4>
            <a href="/contact" class="btn btn-primary">Discuss Your Project</a>
          </div>
        </article>

        <!-- Sidebar Info -->
        <aside class="project-sidebar">
          <div class="sidebar-card">
            <h3 class="sidebar-title">Project Overview</h3>
            <div class="info-list">
              <div class="info-row">
                <span class="info-label">Sector</span>
                <span class="info-val">{project.category}</span>
              </div>
              <div class="info-row">
                <span class="info-label">Location</span>
                <span class="info-val">State of Qatar</span>
              </div>
              <div class="info-row">
                <span class="info-label">Consultancy Focus</span>
                <span class="info-val">Civil & Contracting</span>
              </div>
              <div class="info-row">
                <span class="info-label">Status</span>
                <span class="info-val highlight">Completed</span>
              </div>
            </div>
            <a href="/contact" class="btn btn-secondary btn-full" style="margin-top: 1.5rem;">
              Request Case Study Details
            </a>
          </div>

          <!-- Other Projects -->
          <div class="sidebar-card">
            <h3 class="sidebar-title">Other Iconic Projects</h3>
            <div class="related-list">
              {relatedProjects.map((rel) => (
                <a href={`/projects/${rel.slug}`} class="related-item">
                  <img src={rel.image} alt={rel.title} class="related-thumb" />
                  <div>
                    <h5 class="related-title">{rel.title}</h5>
                    <span class="related-cat">{rel.category}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<style>
  .project-hero {
    background: linear-gradient(135deg, #07192e 0%, #0d2847 60%, #164273 100%);
    color: #ffffff;
    padding: 4.5rem 0 3.5rem;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: #94a3b8;
    margin-bottom: 1.25rem;
  }

  .breadcrumbs a:hover {
    color: var(--accent);
  }

  .breadcrumbs .current {
    color: #ffffff;
    font-weight: 600;
  }

  .project-tag {
    display: inline-block;
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: rgba(217, 147, 27, 0.15);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 1rem;
  }

  .project-title {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .project-title {
      font-size: 3rem;
    }
  }

  .project-lead {
    font-size: 1.15rem;
    color: #cbd5e1;
    max-width: 800px;
    line-height: 1.6;
  }

  /* Layout */
  .project-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .project-layout {
      grid-template-columns: 2.2fr 1fr;
      align-items: start;
    }
  }

  .project-featured-image-box {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    margin-bottom: 2.5rem;
    background: #0f172a;
    max-height: 520px;
  }

  .project-featured-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-content-body {
    font-size: 1.05rem;
    line-height: 1.85;
    color: var(--text-main);
  }

  /* Styling rendered WordPress HTML elements */
  .project-content-body :global(h2) {
    font-size: 1.85rem;
    font-weight: 800;
    color: var(--primary);
    margin: 2rem 0 1rem;
  }

  .project-content-body :global(h3) {
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--primary);
    margin: 1.75rem 0 0.85rem;
  }

  .project-content-body :global(p) {
    margin-bottom: 1.25rem;
    color: #334155;
  }

  .project-content-body :global(ul), .project-content-body :global(ol) {
    margin: 1rem 0 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .project-content-body :global(li) {
    line-height: 1.65;
  }

  .project-content-body :global(img) {
    border-radius: var(--radius-md);
    margin: 1.75rem 0;
    box-shadow: var(--shadow-md);
  }

  .project-share-bar {
    background: #f8fafc;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 2rem;
    margin-top: 3.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  @media (min-width: 640px) {
    .project-share-bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .project-share-bar h4 {
    font-size: 1.2rem;
    color: var(--primary);
  }

  /* Sidebar */
  .project-sidebar {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    position: sticky;
    top: 6.5rem;
  }

  .sidebar-card {
    background: #f8fafc;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.75rem;
  }

  .sidebar-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 1.25rem;
    position: relative;
    padding-bottom: 0.5rem;
  }

  .sidebar-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 35px;
    height: 2px;
    background: var(--accent);
  }

  .info-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-light);
    font-size: 0.9rem;
  }

  .info-label {
    color: var(--text-muted);
    font-weight: 500;
  }

  .info-val {
    font-weight: 600;
    color: var(--primary);
  }

  .info-val.highlight {
    color: #16a34a;
  }

  .btn-full {
    display: block;
    width: 100%;
    text-align: center;
  }

  .related-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .related-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    transition: var(--transition);
  }

  .related-item:hover {
    transform: translateX(4px);
  }

  .related-thumb {
    width: 60px;
    height: 60px;
    border-radius: var(--radius-sm);
    object-fit: cover;
    flex-shrink: 0;
  }

  .related-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--primary);
    line-height: 1.35;
    margin-bottom: 0.2rem;
  }

  .related-item:hover .related-title {
    color: var(--accent);
  }

  .related-cat {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
</style>
